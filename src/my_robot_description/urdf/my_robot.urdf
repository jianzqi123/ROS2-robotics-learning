<?xml version="1.0"?>
<robot name="my_robot">

<link name="base_link">
    <visual>
      <geometry>
        <box size="0.4 0.3 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.3 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <inertia ixx="0.0417" ixy="0" ixz="0" iyy="0.0708" iyz="0" izz="0.1042"/>
    </inertial>
  </link>

  <link name="left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
   <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.000379" ixy="0" ixz="0" iyy="0.000379" iyz="0" izz="0.000625"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.18 -0.05" rpy="1.5708 0 0"/>
    <!-- 轴填 0 0 -1: 关节origin的 rpy=1.5708 绕X 会把本地z轴映射到世界 -Y,
         而差速驱动约定轮子绕 +Y 正转=前进。若填 0 0 1, DiffDrive 下发的正转速
         会让车倒着走(v和w同时反号), odom 与真实运动完全相反。 -->
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.000379" ixy="0" ixz="0" iyy="0.000379" iyz="0" izz="0.000625"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.18 -0.05" rpy="1.5708 0 0"/>
    <!-- 轴填 0 0 -1: 关节origin的 rpy=1.5708 绕X 会把本地z轴映射到世界 -Y,
         而差速驱动约定轮子绕 +Y 正转=前进。若填 0 0 1, DiffDrive 下发的正转速
         会让车倒着走(v和w同时反号), odom 与真实运动完全相反。 -->
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- 前后万向轮:限制底盘绕轮轴的俯仰行程。
       最低点 z=-0.0965,比轮子接地面(z=-0.10)高 3.5mm。

       注意:车并不是"平时悬空、只在俯仰时才接住"。雷达 0.3kg 装在 x=+0.12,
       把质心推到轮轴前方 0.3*0.12/6.4 = 5.6mm,没有任何东西平衡它,
       所以车每次都会前倾到前万向轮触地为止 —— 前轮是常态承载的。
       这一点是实测出来的(Gazebo ground truth 静止俯仰 1.9091°),
       不要再假设它不受力。

       间隙 3.5mm 是这样定的:俯仰 = atan(0.0035/0.15) = 1.337°,
       而 /scan 取的那条光束本身是 +1.000°(见下方雷达注释),
       净仰角 = 1.000 - 1.337 = -0.337°,略微朝下。
       静止时雷达高 0.1822m,光束触地距离 0.1822/tan(0.337°) = 31.0m,
       超出雷达 30m 量程 —— 地面点在物理上无法被返回。
       原来的 5.0mm 对应触地 11.40m,短于房间对角线 12.81m,
       长视线上会打到地板。临界值是 4.739mm,原设计差 0.26mm。

       为什么略微朝下比朝上好:朝下的光束不会漏掉矮障碍物,
       而朝上的光束会在一定距离外从矮物体上方掠过 —— 对 Nav2 是安全隐患。

       切忌与轮子接地面共面 —— 四点共面会让法向载荷分配超静定,
       万向轮把载荷全扛走,轮子失去侧向约束,表现为转向严重不足。
       底盘前下角触地仍在 atan(0.05/0.20)=14.04°,远未触及。 -->
  <link name="caster_front">
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="gray">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front"/>
    <origin xyz="0.15 0 -0.0465" rpy="0 0 0"/>
  </joint>

  <link name="caster_rear">
    <visual>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <material name="gray">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="caster_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rear"/>
    <origin xyz="-0.15 0 -0.0465" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.07"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0 0 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.000310" ixy="0" ixz="0" iyy="0.000310" iyz="0" izz="0.000375"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.12 0 0.085" rpy="0 0 0"/>
  </joint>
  <!-- 万向轮摩擦清零:它们是fixed joint不会滚动,有摩擦会阻碍转弯 -->
  <gazebo reference="caster_front">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="caster_rear">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.36</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <tf_topic>/tf</tf_topic>
    </plugin>
  </gazebo>

  <!-- 关节状态发布:让 RViz 里的轮子真正跟着仿真转。
       没有它就只能靠通用的 joint_state_publisher 节点发静态 0 位,
       轮子 TF 与物理仿真完全解耦 —— 看上去像"轮子没转",
       实际是没有任何人把仿真里的转角告诉 TF 树。
       默认话题是 /world/<world_name>/model/<model_name>/joint_state,
       显式指定成 joint_states,桥接参数就不必跟着世界名和模型名改。 -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>
 <gazebo reference="lidar_link">
    <sensor name="lidar_link" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <!-- 保持 16 线 ±15° 的 3D 雷达。/scan/points 出完整点云,
               /scan (LaserScan) 只取其中水平的一行给 slam_toolbox 做 2D 建图。 -->
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
</robot>
